# ============================================
# Configuration Google OAuth - Frontend Angular
# ============================================

# Google OAuth Client ID (obtenu depuis Google Cloud Console)
# Format: xxxxx-xxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
# Frontend Angular (medichat) : `npm start` exécute env:sync et lit aussi cette clé
NG_APP_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# URL de redirection après authentification Google
VITE_GOOGLE_REDIRECT_URI=http://localhost:4200/auth/google/callback

# Google Cloud Console → APIs et services → Identifiants → ton client OAuth « Application Web »
# → « Origines JavaScript autorisées » : ajoute EXACTEMENT l’origine de la barre d’adresse (sans chemin), par ex. :
#   http://localhost:4200
# Si tu ouvres le site en 127.0.0.1 ou une IP LAN, ajoute aussi cette origine (localhost ≠ 127.0.0.1 pour Google).
# Sinon : erreur 403 sur .../gsi/status et « The given origin is not allowed for the given client ID ».

# ============================================
# Configuration Backend Spring Boot
# ============================================

# Port du serveur
SERVER_PORT=8081

# Database MySQL
DB_URL=jdbc:mysql://localhost:3306/gestion_clinique_medichat
DB_USERNAME=root
DB_PASSWORD=

# JPA/Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# ============================================
# JWT Secret pour tokens
# ============================================

# Clé secrète pour signer les JWT (générer une chaîne aléatoire forte)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_with_something_long_and_random

# Durée d'expiration du token JWT (en millisecondes)
JWT_EXPIRATION=86400000

# ============================================
# Google OAuth - Backend
# ============================================

# Google OAuth Client ID (même que frontend)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# Google OAuth Client Secret (obtenu depuis Google Cloud Console)
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
